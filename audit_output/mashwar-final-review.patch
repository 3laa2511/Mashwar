+    vehicleType: 'motorcycle',
+    vehiclePlate: '٤٣٢١ م ن',
+    subscriptionStatus: 'active',
+    subscriptionPlanCode: 'EL_BAGOUR_MONTHLY_STANDARD',
+    currentPeriodEndsAt: new Date(Date.now() + 25 * 86400000).toISOString(),
