+/**
+ * Mashwar — Dispatch Assignment Service & Concurrency Guard
+ * Target Hub: El Bagour, Menoufia Governorate, Egypt
+ *
+ * Implements atomic row-level assignment locking (simulating PostgreSQL SELECT FOR UPDATE)
+ * to prevent race conditions when multiple captains accept the same order simultaneously.
+ */
+
+import { CaptainProfile, Order } from '../types/index.js';
+import { CaptainEligibilityEngine } from '../captain/captainEligibility.js';
+
+export interface AssignmentResult {
+  success: boolean;
+  order: Order;
+  assignedCaptainId: string;
+  assignedAt: string;
+}
+
+export class AssignmentService {
+  // Map of orderId to running lock promise
+  private static orderLocks: Map<string, Promise<void>> = new Map();
+
+  /**
+   * Concurrently-safe method for a captain to claim an order broadcast.
+   * Supports passing an Order or a getter function to ensure the latest state
+   * is read after acquiring the row lock.
+   */
+  public static async claimOrder(
+    orderOrGetter: Order | (() => Order),
+    captain: CaptainProfile,
+    mutateOrderState: (updated: Order) => Promise<void> | void
+  ): Promise<AssignmentResult> {
+    // 1. Verify captain eligibility before attempting lock acquisition
+    const eligibility = CaptainEligibilityEngine.evaluate(captain);
+    if (!eligibility.isEligibleForNewOffers) {
+      const err = new Error(
+        `لا يمكن إسناد الطلب للكابتن: ${eligibility.reasonsBlockedAr.join(' ')}`
+      );
+      (err as any).code = 'CAPTAIN_INELIGIBLE_FOR_DISPATCH';
+      (err as any).statusCode = 403;
+      throw err;
+    }
+
+    const initialOrder = typeof orderOrGetter === 'function' ? orderOrGetter() : orderOrGetter;
+    const orderId = initialOrder.id;
+
+    // 2. Chained Lock Synchronization (simulates SELECT * FROM orders WHERE id = $1 FOR UPDATE)
+    const prevLock = this.orderLocks.get(orderId) || Promise.resolve();
+    let releaseLock!: () => void;
+    const currentLock = new Promise<void>((resolve) => {
+      releaseLock = resolve;
+    });
+
+    // Update queue head
+    this.orderLocks.set(
+      orderId,
+      prevLock.then(() => currentLock).catch(() => currentLock)
+    );
+
+    await prevLock;
+
+    try {
+      // 3. Read latest committed state inside the critical section
+      const currentOrder = typeof orderOrGetter === 'function' ? orderOrGetter() : orderOrGetter;
+
+      const claimableStatuses = ['searching_captain', 'created', 'ready_for_pickup'];
+      if (!claimableStatuses.includes(currentOrder.status)) {
+        const err = new Error(
+          `عذراً، الطلب لم يعد متاحاً للإسناد (الحالة الحالية: ${currentOrder.status}).`
+        );
+        (err as any).code = 'ORDER_NOT_AVAILABLE_FOR_CLAIM';
+        (err as any).statusCode = 409;
+        throw err;
+      }
+
+      if (currentOrder.assignedCaptainId) {
+        const err = new Error(
+          'عذراً، تم قبول هذا الطلب بالفعل من قبل كابتن آخر في محيط المنطقة.'
+        );
+        (err as any).code = 'ASSIGNMENT_ALREADY_CLAIMED';
+        (err as any).statusCode = 409;
+        throw err;
+      }
+
+      if (
+        currentOrder.cityId &&
+        captain.cityId &&
+        currentOrder.cityId !== captain.cityId
+      ) {
+        const err = new Error(
+          'عذراً، هذا الطلب خارج النطاق الجغرافي للمدينة المسجل بها الكابتن.'
+        );
+        (err as any).code = 'CAPTAIN_ZONE_MISMATCH';
+        (err as any).statusCode = 422;
+        throw err;
+      }
+
+      // 4. Atomically commit assignment
+      const nowIso = new Date().toISOString();
+      const updatedOrder: Order = {
+        ...currentOrder,
+        status: 'captain_assigned',
+        assignedCaptainId: captain.id,
+        captainName: captain.fullName,
+        captainPhone: captain.phone,
+        captainVehicle: `${captain.vehicleType === 'motorcycle' ? 'دراجة نارية' : 'مركبة'} (${captain.vehiclePlate})`,
+        updatedAt: nowIso,
+      };
+
+      await mutateOrderState(updatedOrder);
+
+      return {
+        success: true,
+        order: updatedOrder,
+        assignedCaptainId: captain.id,
+        assignedAt: nowIso,
+      };
+    } finally {
+      releaseLock();
+    }
+  }
+}
diff -ruN /app/applet/audit_output/zip_extracted/backend/src/orders/orderFsm.ts /app/applet/audit_output/final_staging/backend/src/orders/orderFsm.ts
--- /app/applet/audit_output/zip_extracted/backend/src/orders/orderFsm.ts	1970-01-01 00:00:00.000000000 +0000
+++ /app/applet/audit_output/final_staging/backend/src/orders/orderFsm.ts	2026-10-24 00:31:35.620825731 +0000
@@ -0,0 +1,198 @@
+/**
+ * Mashwar — Authoritative Order Finite State Machine (FSM)
+ * Target Hub: El Bagour, Menoufia Governorate, Egypt
+ */
+
+import { Order, OrderStatus, OrderTransitionRequest } from '../types/index.js';
+
+export interface StateTransitionResult {
+  previousStatus: OrderStatus;
+  newStatus: OrderStatus;
+  order: Order;
+  auditLog: {
+    orderId: string;
+    fromStatus: OrderStatus;
+    toStatus: OrderStatus;
+    actorId: string;
+    actorRole: string;
+    timestamp: string;
+    notes?: string;
+  };
+}
+
+// Strict state transition map supporting both direct delivery and store/restaurant fulfillment
+const ALLOWED_TRANSITIONS: Record<OrderStatus, OrderStatus[]> = {
+  created: ['accepted_by_store', 'searching_captain', 'cancelled'],
+  accepted_by_store: ['preparing', 'ready_for_pickup', 'cancelled'],
+  preparing: ['ready_for_pickup', 'cancelled'],
+  ready_for_pickup: ['searching_captain', 'captain_assigned', 'at_pickup', 'cancelled'],
+  searching_captain: ['captain_assigned', 'cancelled'],
+  captain_assigned: ['at_pickup', 'picked_up', 'cancelled'],
+  at_pickup: ['picked_up', 'in_transit', 'cancelled'],
+  picked_up: ['in_transit', 'delivered', 'cancelled'],
+  in_transit: ['delivered', 'cancelled'],
+  delivered: [], // Terminal state
+  cancelled: [], // Terminal state
+};
+
+const STORE_STAGE_TARGETS: OrderStatus[] = ['accepted_by_store', 'preparing', 'ready_for_pickup'];
+const CAPTAIN_DELIVERY_TARGETS: OrderStatus[] = ['at_pickup', 'picked_up', 'in_transit'];
+
+export class OrderFsm {
+  /**
+   * Evaluates if a transition from current status to target status is topologically valid.
+   */
+  public static canTransition(currentStatus: OrderStatus, targetStatus: OrderStatus): boolean {
+    const allowed = ALLOWED_TRANSITIONS[currentStatus] || [];
+    return allowed.includes(targetStatus);
+  }
+
+  /**
+   * Applies an authoritative transition to an order with strict precondition validation.
+   */
+  public static transition(order: Order, request: OrderTransitionRequest): StateTransitionResult {
+    const { targetStatus, actorId, actorRole, notes, cashCollectedPiasters, cancellationReason } = request;
+    const currentStatus = order.status;
+
+    // Invariant 1: Check if already in terminal state
+    if (currentStatus === 'delivered' || currentStatus === 'cancelled') {
+      const err = new Error(
+        `لا يمكن تعديل حالة الطلب نظراً لوصوله إلى حالة نهائية (${currentStatus === 'delivered' ? 'تم التسليم' : 'ملغي'}).`
+      );
+      (err as any).code = 'TERMINAL_STATE_MUTATION_FORBIDDEN';
+      (err as any).statusCode = 422;
+      throw err;
+    }
+
+    // Invariant 2: Check legal transition in FSM graph
+    if (!this.canTransition(currentStatus, targetStatus)) {
+      const err = new Error(
+        `انتقال غير صالح لحالة الطلب من '${currentStatus}' إلى '${targetStatus}'. يرجى اتباع دورة حياة الطلب الرسمية.`
+      );
+      (err as any).code = 'INVALID_STATE_TRANSITION';
+      (err as any).statusCode = 422;
+      throw err;
+    }
+
+    // Invariant 3: Store preparation stage role & ownership checks
+    if (STORE_STAGE_TARGETS.includes(targetStatus)) {
+      const allowedStoreRoles = ['merchant', 'owner', 'operations_dispatcher', 'operations'];
+      if (!allowedStoreRoles.includes(actorRole)) {
+        const err = new Error('غير مصرح لهذا الحساب بتحديث مراحل تجهيز المتجر.');
+        (err as any).code = 'UNAUTHORIZED_STORE_STAGE_ACTOR';
+        (err as any).statusCode = 403;
+        throw err;
+      }
+
+      if (actorRole === 'merchant' && order.merchantUserId && order.merchantUserId !== actorId) {
+        const err = new Error('غير مصرح للتاجر بتحديث حالة طلب يخص متجراً آخر.');
+        (err as any).code = 'UNAUTHORIZED_MERCHANT_ACTION';
+        (err as any).statusCode = 403;
+        throw err;
+      }
+    }
+
+    // Invariant 4: Precondition check for Captain Assignment
+    if (targetStatus === 'captain_assigned') {
+      if (!order.assignedCaptainId) {
+        const err = new Error('لا يمكن تحويل الطلب إلى "تم إسناد الكابتن" بدون تحديد هوية كابتن معتمد.');
+        (err as any).code = 'MISSING_ASSIGNED_CAPTAIN';
+        (err as any).statusCode = 422;
+        throw err;
+      }
+    }
+
+    // Invariant 5: Actor authorization check for captain delivery steps
+    if (CAPTAIN_DELIVERY_TARGETS.includes(targetStatus)) {
+      if (actorRole === 'merchant' || actorRole === 'customer') {
+        const err = new Error('غير مصرح للتاجر أو العميل بتحديث خطوات التوصيل الميدانية الخاصة بالكابتن.');
+        (err as any).code = 'UNAUTHORIZED_CAPTAIN_STAGE_ACTOR';
+        (err as any).statusCode = 403;
+        throw err;
+      }
+      if (actorRole === 'captain' && order.assignedCaptainId && order.assignedCaptainId !== actorId) {
+        const err = new Error('غير مصرح لك بتحديث حالة هذا الطلب (الكابتن غير مطابق للكابتن المسند).');
+        (err as any).code = 'UNAUTHORIZED_CAPTAIN_ACTION';
+        (err as any).statusCode = 403;
+        throw err;
+      }
+    }
+
+    // Invariant 6: Cash on Delivery verification precondition for 'delivered'
+    let updatedCashCollected = order.cashCollectedPiasters;
+    let updatedIsPaid = order.isPaid;
+
+    if (targetStatus === 'delivered') {
+      if (actorRole === 'merchant' || actorRole === 'customer') {
+        const err = new Error('إتمام التسليم النهائي يتم حصرياً بواسطة الكابتن المسند أو غرفة العمليات.');
+        (err as any).code = 'UNAUTHORIZED_DELIVERY_COMPLETION';
+        (err as any).statusCode = 403;
+        throw err;
+      }
+
+      if (order.paymentMethod === 'cash_on_delivery') {
+        const amountCollected = cashCollectedPiasters ?? order.cashCollectedPiasters;
+        if (amountCollected === undefined || amountCollected === null) {
+          const err = new Error(
+            'لا يمكن إتمام تسليم الطلب نقداً بدون تسجيل المبلغ المحصل من العميل عند باب المنزل.'
+          );
+          (err as any).code = 'MISSING_CASH_COLLECTION';
+          (err as any).statusCode = 422;
+          throw err;
+        }
+
+        if (amountCollected < order.totalFarePiasters) {
+          const err = new Error(
+            `المبلغ المسجل المحصل (${(amountCollected / 100).toFixed(2)} ج.م) أقل من إجمالي الأجرة المطلوبة (${(order.totalFarePiasters / 100).toFixed(2)} ج.م).`
+          );
+          (err as any).code = 'INSUFFICIENT_CASH_COLLECTED';
+          (err as any).statusCode = 422;
+          throw err;
+        }
+
+        updatedCashCollected = amountCollected;
+        updatedIsPaid = true;
+      } else {
+        // Electronic payment: must already be paid
+        if (!order.isPaid) {
+          const err = new Error(
+            'لا يمكن إتمام التسليم لأن الدفع الإلكتروني لم يتم تأكيده بعد من بوابة الدفع.'
+          );
+          (err as any).code = 'ELECTRONIC_PAYMENT_UNCONFIRMED';
+          (err as any).statusCode = 422;
+          throw err;
+        }
+      }
+    }
+
+    // Prepare updated order object
+    const nowIso = new Date().toISOString();
+    const updatedOrder: Order = {
+      ...order,
+      status: targetStatus,
+      cashCollectedPiasters: updatedCashCollected,
+      isPaid: updatedIsPaid,
+      specialInstructions: cancellationReason
+        ? `${order.specialInstructions ? order.specialInstructions + ' | ' : ''}سبب الإلغاء: ${cancellationReason}`
+        : order.specialInstructions,
+      updatedAt: nowIso,
+    };
+
+    const auditLog = {
+      orderId: order.id,
+      fromStatus: currentStatus,
+      toStatus: targetStatus,
+      actorId,
+      actorRole,
+      timestamp: nowIso,
+      notes: notes || (cancellationReason ? `إلغاء: ${cancellationReason}` : undefined),
+    };
+
+    return {
+      previousStatus: currentStatus,
+      newStatus: targetStatus,
+      order: updatedOrder,
+      auditLog,
+    };
+  }
+}
diff -ruN /app/applet/audit_output/zip_extracted/backend/src/pricing/pricingEngine.ts /app/applet/audit_output/final_staging/backend/src/pricing/pricingEngine.ts
--- /app/applet/audit_output/zip_extracted/backend/src/pricing/pricingEngine.ts	1970-01-01 00:00:00.000000000 +0000
+++ /app/applet/audit_output/final_staging/backend/src/pricing/pricingEngine.ts	2026-10-24 00:31:35.620705756 +0000
@@ -0,0 +1,261 @@
+/**
+ * Mashwar — Authoritative Server-Side Pricing Engine
+ * Target Hub: El Bagour, Menoufia Governorate, Egypt
+ * Monetary Units: Egyptian Piasters (قروش) — Integer Minor Units (1 EGP = 100 Piasters)
+ */
+
+import crypto from 'node:crypto';
+import { FareQuote, ServiceTypeId } from '../types/index.js';
+import { PersistentStore } from '../store/persistentStore.js';
+
+export interface PricingConfig {
+  baseFarePiasters: number; // 1500 (15.00 EGP) for first 1.5 km
+  baseIncludedKm: number; // 1.5 km
+  ratePerKmPiasters: number; // 400 (4.00 EGP per subsequent km)
+  ruralSurchargePiasters: number; // 500 (5.00 EGP for unpaved / village roads)
+  platformFeePiasters: number; // 200 (2.00 EGP service fee)
+  quoteValidityMinutes: number; // 15 minutes
+  hmacSecret: string;
+}
+
+export const DEFAULT_PRICING_CONFIG: PricingConfig = {
+  baseFarePiasters: 1500,
+  baseIncludedKm: 1.5,
+  ratePerKmPiasters: 400,
+  ruralSurchargePiasters: 500,
+  platformFeePiasters: 200,
+  quoteValidityMinutes: 15,
+  hmacSecret: process.env.PRICING_HMAC_SECRET || 'mashwar_el_bagour_authoritative_quote_secret_2026',
+};
+
+export class PricingEngine {
+  constructor(private config: PricingConfig = DEFAULT_PRICING_CONFIG) {}
+
+  /**
+   * Calculates an authoritative fare quote and returns a tamper-evident signed quote object.
+   * Supports zone-specific tariffs (El Bagour, Shebin El-Kom, Menouf, etc.) and optional store item subtotals.
+   */
+  public generateQuote(params: {
+    serviceTypeId: ServiceTypeId;
+    distanceKm: number;
+    isRuralOrVillage?: boolean;
+    zoneId?: string;
+    cityId?: string;
+    itemsSubtotalPiasters?: number;
+    pickupLandmark?: string;
+    dropoffLandmark?: string;
+  }): FareQuote {
+    const {
+      serviceTypeId,
+      distanceKm,
+      isRuralOrVillage = false,
+      zoneId,
+      cityId,
+      itemsSubtotalPiasters = 0,
+    } = params;
+
+    // Invariant 1: Regulatory lock on passenger mobility
+    if (serviceTypeId === 'passenger') {
+      const err = new Error(
+        'عذراً، خدمة نقل الركاب معلقة حالياً لحين استيفاء الاشتراطات والتراخيص القانونية وفقاً للقانون رقم ٧٣ لسنة ٢٠١٨.'
+      );
+      (err as any).code = 'REGULATORY_COMPLIANCE_LOCK';
+      (err as any).statusCode = 403;
+      throw err;
+    }
+
+    // Invariant 2: Distance must be non-negative and realistic
+    if (distanceKm < 0 || Number.isNaN(distanceKm)) {
+      const err = new Error('المسافة لا يمكن أن تكون قيمة سالبة.');
+      (err as any).code = 'INVALID_DISTANCE';
+      (err as any).statusCode = 400;
+      throw err;
+    }
+
+    if (distanceKm > 75) {
+      const err = new Error('المسافة تتجاوز النطاق التشغيلي الأقصى لمركز الباجور والمحافظات المجاورة.');
+      (err as any).code = 'OUT_OF_BOUNDS_DISTANCE';
+      (err as any).statusCode = 400;
+      throw err;
+    }
+
+    if (itemsSubtotalPiasters < 0 || !Number.isInteger(itemsSubtotalPiasters)) {
+      const err = new Error('قيمة مشتريات المتجر بالقرش يجب أن تكون عدداً صحيحاً غير سالب.');
+      (err as any).code = 'INVALID_ITEMS_SUBTOTAL';
+      (err as any).statusCode = 400;
+      throw err;
+    }
+
+    // Resolve zone-specific tariff if zoneId is provided
+    let baseFarePiasters = this.config.baseFarePiasters;
+    let baseIncludedKm = this.config.baseIncludedKm;
+    let ratePerKmPiasters = this.config.ratePerKmPiasters;
+    let configuredRuralSurcharge = this.config.ruralSurchargePiasters;
+    let platformFeePiasters = this.config.platformFeePiasters;
+    let resolvedCityId = cityId || 'city_el_bagour';
+    let resolvedZoneId = zoneId || (isRuralOrVillage ? 'zone_bagour_villages' : 'zone_bagour_center');
+    let effectiveRural = isRuralOrVillage;
+
+    if (zoneId) {
+      const zone = PersistentStore.getZoneById(zoneId);
+      if (!zone) {
+        const err = new Error(`نطاق الخدمة المطلوب (${zoneId}) غير مسجل بالنظام.`);
+        (err as any).code = 'ZONE_NOT_FOUND';
+        (err as any).statusCode = 404;
+        throw err;
+      }
+
+      const city = PersistentStore.getCityById(zone.cityId);
+      if (!zone.isActive || (city && !city.isActive)) {
+        const err = new Error(`نطاق الخدمة (${zone.nameAr}) غير مفعل للتشغيل حالياً.`);
+        (err as any).code = 'ZONE_INACTIVE';
+        (err as any).statusCode = 403;
+        throw err;
+      }
+
+      resolvedCityId = zone.cityId;
+      resolvedZoneId = zone.id;
+      if (zone.isRural) {
+        effectiveRural = true;
+      }
+
+      const tariff = PersistentStore.getZoneTariff(zone.id, serviceTypeId);
+      if (tariff) {
+        if (!tariff.isActive) {
+          const err = new Error(`تعريفة الخدمة لهذه المنطقة غير مفعلة حالياً.`);
+          (err as any).code = 'TARIFF_INACTIVE';
+          (err as any).statusCode = 403;
+          throw err;
+        }
+        baseFarePiasters = tariff.baseFarePiasters;
+        baseIncludedKm = tariff.baseIncludedKm;
+        ratePerKmPiasters = tariff.ratePerKmPiasters;
+        configuredRuralSurcharge = tariff.ruralSurchargePiasters;
+        platformFeePiasters = tariff.platformFeePiasters;
+      }
+    }
+
+    // Fare calculation in pure integer piasters (no floating point representation errors)
+    const chargeableKm = distanceKm > baseIncludedKm ? distanceKm - baseIncludedKm : 0;
+    const distanceFarePiasters = Math.round(chargeableKm * ratePerKmPiasters);
+    const ruralSurchargePiasters = effectiveRural ? configuredRuralSurcharge : 0;
+
+    const totalFarePiasters =
+      baseFarePiasters +
+      distanceFarePiasters +
+      ruralSurchargePiasters +
+      platformFeePiasters +
+      itemsSubtotalPiasters;
+
+    const quoteId = `quote_${crypto.randomBytes(6).toString('hex')}`;
+    const now = new Date();
+    const expiresAt = new Date(now.getTime() + this.config.quoteValidityMinutes * 60 * 1000).toISOString();
+
+    // Estimate duration: 25 km/h in urban delta + 5 min pickup buffer
+    const minMinutes = Math.ceil(distanceKm * 2.4 + 5);
+    const maxMinutes = minMinutes + 5;
+    const estimatedDurationMinutes = `${minMinutes}-${maxMinutes}`;
+
+    const formattedTotalEgp = `${(totalFarePiasters / 100).toFixed(2)} ج.م`;
+
+    const lineItems = [
+      {
+        title: `الأجرة الأساسية (أول ${baseIncludedKm} كم)`,
+        amountPiasters: baseFarePiasters,
+      },
+    ];
+
+    if (distanceFarePiasters > 0) {
+      lineItems.push({
+        title: `تكلفة المسافة (${chargeableKm.toFixed(1)} كم إضافي)`,
+        amountPiasters: distanceFarePiasters,
+      });
+    }
+
+    if (ruralSurchargePiasters > 0) {
+      lineItems.push({
+        title: 'بدل طرق غير ممهدة / قرى المراكز',
+        amountPiasters: ruralSurchargePiasters,
+      });
+    }
+
+    if (itemsSubtotalPiasters > 0) {
+      lineItems.push({
+        title: 'إجمالي منتجات المتجر (بدون عمولة إضافية)',
+        amountPiasters: itemsSubtotalPiasters,
+      });
+    }
+
+    lineItems.push({
+      title: 'رسوم تشغيل المنصة ودعم الأسطول',
+      amountPiasters: platformFeePiasters,
+    });
+
+    const signaturePayload = `${quoteId}:${serviceTypeId}:${totalFarePiasters}:${expiresAt}`;
+    const signature = crypto
+      .createHmac('sha256', this.config.hmacSecret)
+      .update(signaturePayload)
+      .digest('hex');
+
+    return {
+      quoteId,
+      serviceTypeId,
+      cityId: resolvedCityId,
+      zoneId: resolvedZoneId,
+      distanceKm,
+      baseFarePiasters,
+      distanceFarePiasters,
+      ruralSurchargePiasters,
+      platformFeePiasters,
+      ...(itemsSubtotalPiasters > 0 ? { itemsSubtotalPiasters } : {}),
+      totalFarePiasters,
+      formattedTotalEgp,
+      currency: 'EGP',
+      estimatedDurationMinutes,
+      expiresAt,
+      signature,
+      lineItems,
+    };
+  }
+
+  /**
+   * Verifies the authenticity and validity of a fare quote.
+   * Throws if expired, tampered, or invalid.
+   */
+  public verifyQuote(quote: {
+    quoteId: string;
+    serviceTypeId: ServiceTypeId;
+    totalFarePiasters: number;
+    expiresAt: string;
+    signature: string;
+  }): boolean {
+    const { quoteId, serviceTypeId, totalFarePiasters, expiresAt, signature } = quote;
+
+    // Check expiration
+    const expiresTime = new Date(expiresAt).getTime();
+    if (Date.now() > expiresTime) {
+      const err = new Error('عذراً، انتهت صلاحية تسعيرة التوصيل. يرجى طلب تسعيرة جديدة.');
+      (err as any).code = 'QUOTE_EXPIRED';
+      (err as any).statusCode = 400;
+      throw err;
+    }
+
+    // Verify cryptographic signature
+    const signaturePayload = `${quoteId}:${serviceTypeId}:${totalFarePiasters}:${expiresAt}`;
+    const expectedSignature = crypto
+      .createHmac('sha256', this.config.hmacSecret)
+      .update(signaturePayload)
+      .digest('hex');
+
+    const sigBuf = Buffer.from(signature);
+    const expBuf = Buffer.from(expectedSignature);
+    if (sigBuf.length !== expBuf.length || !crypto.timingSafeEqual(sigBuf, expBuf)) {
+      const err = new Error('عذراً، التسعيرة غير مطابقة أو تم التلاعب بها.');
+      (err as any).code = 'QUOTE_SIGNATURE_TAMPERED';
+      (err as any).statusCode = 400;
+      throw err;
+    }
+
+    return true;
+  }
+}
