# ============================================================================
# Mashwar (مشوار) — Environment Configuration Template (.env.example)
# Launch Hub: El Bagour, Menoufia Governorate, Egypt
# SECURITY NOTICE: Never commit real secrets, service-role keys, or passwords.
# ============================================================================

# Server & Runtime
PORT="3000"
NODE_ENV="development"
APP_URL="http://localhost:3000"

# PostgreSQL Database (Kysely + pg connection pool)
# When unset in local preview mode, Mashwar falls back to PersistentStore.
DATABASE_URL="postgresql://postgres:CHANGE_ME_PASSWORD@localhost:5432/mashwar_db?sslmode=disable"

# Supabase Authentication (Server-Side JWT Verification)
# Roles are verified exclusively from app_metadata.role (zero trust in user_metadata)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"
SUPABASE_JWT_SECRET="CHANGE_ME_MIN_32_CHAR_SUPABASE_JWT_SECRET"

# Cryptographic Signing Secrets (Server-Only)
PRICING_HMAC_SECRET="CHANGE_ME_AUTHORITATIVE_QUOTE_HMAC_SECRET_KEY"
PAYMENT_WEBHOOK_SECRET="CHANGE_ME_PAYMOB_FAWRY_WEBHOOK_HMAC_SECRET"

# Client-Side Vite Public Variables (Safe for Browser Exposure)
VITE_API_BASE_URL="/api/v1"
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# AI Studio Runtime (Optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
