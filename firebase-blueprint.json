  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private user account profiles, default landmark, referral code, role, and cashback balance."
    },
    "/users/{userId}/walletTransactions/{txId}": {
      "schema": { "$ref": "#/entities/WalletTransaction" },
      "description": "User loyalty cashback earn, top-up proof, referral bonus, and redemption ledger entries."
    },
    "/driverProfiles/{driverId}": {
      "schema": { "$ref": "#/entities/DriverProfile" },
      "description": "Publicly readable verified driver summary with family trust badge and cash ceiling."
    },
    "/stores/{storeId}": {
      "schema": { "$ref": "#/entities/StoreFront" },
      "description": "Publicly readable local merchant storefronts."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/CatalogProduct" },
      "description": "Publicly readable store catalog items."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/DeliveryOrder" },
      "description": "Single-store, multi-stop, AI prescription/list quote, scheduled, or voice-note delivery orders."
    },
    "/rides/{rideId}": {
      "schema": { "$ref": "#/entities/PassengerRide" },
      "description": "Verified local TukTuk, Scooter, and Car passenger rides with 4-digit OTP safety PIN."
    },
    "/commuteSubscriptions/{subId}": {
      "schema": { "$ref": "#/entities/CommuteSubscription" },
      "description": "Recurring daily village-to-center commute subscriptions."
    },
    "/promoCodes/{code}": {
      "schema": { "$ref": "#/entities/PromoCode" },
      "description": "Active discount coupons for El Bagour users."
    },
    "/referrals/{refId}": {
      "schema": { "$ref": "#/entities/ReferralRecord" },
      "description": "Friend referral bonus records."
    },
    "/threads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Real-time participant chat messages scoped to an order or ride."
    }
  }
}
